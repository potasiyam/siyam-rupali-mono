# Glyph classes
@back_bases = [bn_kha bn_ga bn_gha bn_ja bn_nna bn_tha bn_da bn_dha bn_na bn_pa bn_ba bn_ma bn_ya bn_ra bn_la bn_sha bn_ssa bn_sa];
@front_bases = [bn_ka bn_nga bn_cha bn_jha bn_nya bn_tta bn_ttha bn_dda bn_ddha bn_ta bn_pha bn_ha bn_k_ssa];
@kaars = [bn_ukaar bn_uukaar bn_rikaar];
@main_bases = [bn_ka bn_kha bn_ga bn_gha bn_nga bn_ca bn_cha bn_ja bn_jha bn_nya bn_tta bn_ttha bn_dda bn_ddha bn_nna bn_ta bn_tha bn_da bn_dha bn_na bn_pa bn_pha bn_ba bn_bha bn_ma bn_ya bn_ra bn_la bn_sha bn_ssa bn_sa bn_ha bn_rra bn_rrha bn_yya];
@main_bases_half = [bn_k_half bn_kh_half bn_g_half bn_gh_half bn_ng_half bn_c_half bn_ch_half bn_j_half bn_jh_half bn_ny_half bn_tt_half bn_tth_half bn_dd_half bn_ddh_half bn_nn_half bn_t_half bn_th_half bn_d_half bn_dh_half bn_n_half bn_p_half bn_ph_half bn_b_half bn_bh_half bn_m_half bn_y_half bn_half_ra bn_l_half bn_sh_half bn_ss_half bn_s_half bn_h_half bn_rr_half bn_rrh_half bn_yy_half];
@main_bases_haln = [bn_k_hasanta bn_kh_hasanta bn_g_hasanta bn_gh_hasanta bn_ng_hasanta bn_c_hasanta bn_ch_hasanta bn_j_hasanta bn_jh_hasanta bn_ny_hasanta bn_tt_hasanta bn_tth_hasanta bn_dd_hasanta bn_ddh_hasanta bn_nn_hasanta bn_t_hasanta bn_th_hasanta bn_d_hasanta bn_dh_hasanta bn_n_hasanta bn_p_hasanta bn_ph_hasanta bn_b_hasanta bn_bh_hasanta bn_m_hasanta bn_y_hasanta bn_r_hasanta bn_l_hasanta bn_sh_hasanta bn_ss_hasanta bn_s_hasanta bn_h_hasanta bn_rr_hasanta bn_rrh_hasanta bn_yy_hasanta];

# Mark classes
markClass bn_rikaar <anchor -1350 -105> @kaar.blwm;
markClass bn_ukaar <anchor -1380 60> @kaar.blwm;
markClass bn_uukaar <anchor -1365 30> @kaar.blwm;

# Lookups
lookup init {
    sub bn_ekaar by bn_ekaar.init;
    sub bn_aikaar by bn_aikaar.init;
} init;

lookup akhn {
    sub bn_ka bn_hasanth bn_ssa by bn_k_ssa;
    sub bn_ja bn_hasanth bn_nya by bn_j_nya;
} akhn;

lookup rphf {
    sub bn_ra bn_hasanth by bn_half_ra;
    sub asa_ra bn_hasanth by bn_half_ra;
} rphf;

lookup blwf {
    sub bn_ra bn_hasanth by bn_r_phala;
    sub bn_ba bn_hasanth by bn_b_phala;
    sub asa_ra bn_hasanth by bn_r_phala;
    sub asa_ba bn_hasanth by bn_b_phala;
} blwf;

lookup blwf_bng2 {
    sub bn_hasanth bn_ra by bn_r_phala;
    sub bn_hasanth bn_ba by bn_b_phala;
    sub bn_hasanth asa_ra by bn_r_phala;
} blwf_bng2;

